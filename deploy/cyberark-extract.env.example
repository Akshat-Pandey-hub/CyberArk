# CyberArk extraction service - settings template
#
# Copy to cyberark-extract.env, fill in the <...> values, and protect it:
#   chmod 600 cyberark-extract.env
# Load it into the shell before running the jar:
#   set -a; . ./cyberark-extract.env; set +a
# Shell syntax applies: no spaces around '=', and put values with special characters in single quotes,
# e.g. PG_PASSWORD='p@ss$word'. Never commit the filled-in file or send it by chat or e-mail.

# ---- CyberArk PVWA (PAM Self-Hosted) - required for every pvwa-* command and route ----
# The PVWA application URL, ending in /PasswordVault. https is required.
CYBERARK_PVWA_BASE_URL=https://<pvwa-fqdn>/PasswordVault
# Logon method of the service account: CyberArk (default), LDAP, RADIUS or Windows.
CYBERARK_PVWA_AUTH_METHOD=CyberArk
# The dedicated read-only API user (e.g. svc-keyforge-readonly) and its password. Provided by the client.
CYBERARK_PVWA_USERNAME=<service-account-username>
CYBERARK_PVWA_PASSWORD=<service-account-password>

# ---- Optional paging / timing (defaults shown) ----
# Page size for the paged endpoints, 1-1000. Empty = each endpoint's documented default
# (Safes 25, Accounts 50, Safe members 25, Discovered accounts 100, Users and Groups 1000).
#CYBERARK_PVWA_PAGE_SIZE=
# Pause between page requests, in milliseconds.
#CYBERARK_PVWA_THROTTLE_MS=100
# Safety stop: the most pages one list may take (reaching it marks the run INCOMPLETE).
#CYBERARK_PVWA_MAX_PAGES=100000
# HTTP timeout per request, in seconds.
#CYBERARK_TIMEOUT_SECONDS=30

# ---- PostgreSQL destination - required for every extraction ----
PG_HOST=<postgres-host>
PG_PORT=5432
PG_DATABASE=<database-name>
PG_USERNAME=<database-user>
PG_PASSWORD=<database-password>
# Schema for the tables (created if absent). Default: cyberark
PG_DEST_SCHEMA=cyberark

# ---- REST service (start-rest only) ----
# HTTP Basic Auth that every REST call must send. Choose them; there is no default.
REST_USERNAME=<choose-a-username>
REST_PASSWORD=<choose-a-password>
# Listen address and port. 127.0.0.1 (default) accepts calls from this server only. The REST service is plain HTTP:
# only open it to other hosts (e.g. 0.0.0.0) on a trusted network.
#REST_HOST=127.0.0.1
#REST_PORT=8210

# ---- Certificate trust (read by run-extractions.sh, not by the jar) ----
# Only if PVWA uses a certificate from the client's internal CA. A PKCS12 truststore made as described in
# HANDOVER.md ("Certificate trust"): Java's default cacerts plus the client's CA certificate.
#JAVA_TRUSTSTORE=/opt/keyforge-cyberark/client-truststore.p12
#JAVA_TRUSTSTORE_PASSWORD=<truststore-password>

# ---- Use case 1: approver groups (ispss-approver-groups only; not needed for the PVWA extraction) ----
# Identity tenant URL. Documented: https://<tenant>.id.cyberark.cloud ; the client mail uses
# https://<id>.uap.cyberark.cloud/api - which one works must be confirmed by the client.
#CYBERARK_IDENTITY_BASE_URL=https://<tenant>.id.cyberark.cloud
# Optional; default <identity base URL>/oauth2/platformtoken
#CYBERARK_TOKEN_URL=
# OAuth confidential-client service user (login name and password).
#CYBERARK_CLIENT_ID=<identity-service-user>
#CYBERARK_CLIENT_SECRET=<identity-service-user-password>
# roles (default, /Roles/GetRoleMembers) or saasmanage (/SaasManage/GetRoleMembers)
#CYBERARK_ROLE_MEMBERS_API=roles
#CYBERARK_APPROVER_ROLE_PATTERN=APP-CYA-ISPSS-SCA-AWS-%-BUApprovers
#CYBERARK_MIN_APPROVERS=3
#CYBERARK_REDROCK_PAGE_SIZE=1000

# ---- Use case 2: policy health (ispss-policy-health only) ----
# Which policy API the tenant uses: uap (Access Control Policies, default) or sca (SCA Policies API). The official
# Access Control Policies reference says tenants that show their policies on SCA's Policies page must use sca.
#CYBERARK_POLICY_API=uap
# Base URL of that API (only the one for CYBERARK_POLICY_API is needed):
#CYBERARK_UAP_BASE_URL=https://<subdomain>.uap.cyberark.cloud/api
#CYBERARK_SCA_BASE_URL=https://<subdomain>.sca.cyberark.cloud/api
# The policy APIs need the CUSTOM OAuth2 token, not the platform token. Token URL =
# CYBERARK_IDENTITY_BASE_URL + /oauth2/token/ + the Application ID of the custom OAuth2 server web app:
#CYBERARK_POLICY_APP_ID=<application-id>
# ...or give the full token URL instead:
#CYBERARK_POLICY_TOKEN_URL=https://<tenant>.id.cyberark.cloud/oauth2/token/<application-id>
# The OAuth confidential-client service user for the custom OAuth2 app (sent as HTTP Basic auth).
# If left out, CYBERARK_CLIENT_ID / CYBERARK_CLIENT_SECRET above are used.
#CYBERARK_POLICY_CLIENT_ID=<policy-service-user>
#CYBERARK_POLICY_CLIENT_SECRET=<policy-service-user-password>
# Page size for uap, 1-50 (documented maximum 50).
#CYBERARK_POLICY_PAGE_SIZE=50
